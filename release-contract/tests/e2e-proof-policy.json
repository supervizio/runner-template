{
  "schema": "supervizio.release-policy/v1",
  "inventory": {
    "purpose": "validate-release.yml run by hand (workflow_dispatch) on a TEST candidate of supervizio/agent (a v0.0.0-test.N tag that exists nowhere in git, built by agent's release.yml with the `candidate_tag` input). Exactly the production agent legs of policy.json -- e2e.yml in release mode -- except the bridge package: the candidate is pushed to the measurement package this repository already reads, so no production package is created or granted for a test. Never selected by repository_dispatch, and evidence refuses every workflow_dispatch run, so no receipt can come out of it. tests/test_release_contract.py holds it equal to policy.json everywhere else.",
    "pending_prs": {}
  },
  "validation": {
    "repository": "supervizio/runner-template",
    "default_branch": "main",
    "workflow_path": ".github/workflows/validate-release.yml",
    "event_type": "validate-release"
  },
  "receipt_asset": "release-receipt.json",
